{
  "name": "pal-lsp-client",
  "version": "0.1.0",
  "description": "Pal Language Server",
  "categories": [],
  "keywords": [
    "language-server",
    "pal"
  ],
  "license": "MIT",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsgo",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "pal",
        "extensions": [
          ".pal"
        ]
      },
      {
        "id": "pretty",
        "extensions": [
          ".pretty"
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "pal-lsp",
      "properties": {
        "pal-lsp.trace.server": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "No traces",
            "Error only",
            "Full log"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:pal"
  ],
  "engines": {
    "node": "24.13.0",
    "pnpm": ">=10.0.0",
    "vscode": "^1.83.0"
  },
  "packageManager": "pnpm@10.29.3",
  "enabledApiProposals": []
}
