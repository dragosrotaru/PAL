{
  "folders": [
    { "name": "pal", "path": "." },
    { "name": "pal-ts", "path": "pal-ts" },
    { "name": "pal-fs-vscode", "path": "pal-fs-vscode" },
    { "name": "pal-lsp", "path": "pal-lsp" },
    { "name": "pal-lsp-example", "path": "pal-lsp-example" },
    { "name": "pal-eval", "path": "pal-eval" },
    { "name": "pal-fs", "path": "pal-fs" },
    { "name": "pal-rs", "path": "pal-rs" },
    { "name": "wingman", "path": "wingman" },
    { "name": "pal-os", "path": "pal-os" },
    { "name": "hyper-ts", "path": "hyper-ts" },
    { "name": "hyper-fs", "path": "hyper-fs" },
  ],
  "settings": {
    "typescript.experimental.useTsgo": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
      "source.organizeImports": "always",
      "source.removeUnusedImports": "always",
    },
    "editor.formatOnSaveMode": "file",
    "[typescript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "rust-analyzer.showUnlinkedFileNotification": false,
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.cargo.buildScripts.rebuildOnSave": true,
  },
}
