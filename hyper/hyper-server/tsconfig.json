{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./src",
    "outDir": "build",
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "downlevelIteration": true,
    "preserveConstEnums": true,
    "importHelpers": true
  }
}
